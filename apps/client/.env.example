# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@<YOUR_HOST>:5432/postgres
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://<YOUR_CREATED_USER>:<YOUR_PASSWORD>@<YOUR_HOST>:5432/postgres
DB_SCHEMA=your_schema

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-secure-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Go backend (server-only)
BACKEND_URL=http://localhost:8080
INTERNAL_API_KEY=replace-with-the-same-secret-as-the-go-backend

# Resend (verification emails, server-only)
RESEND_API_KEY=your-resend-api-key
RESEND_EMAIL_FROM=no-reply@yourdomain.com
RESEND_DAILY_SEND_LIMIT=100
RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
