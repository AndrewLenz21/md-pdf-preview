# PostgreSQL / Supabase

# Backend Go / direct PostgreSQL connection.
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

DB_SCHEMA=your_schema


# --------------------------------------------------
# Cloudflare Hyperdrive
# --------------------------------------------------

# PRODUCTION:
# Do NOT set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
# in the Cloudflare Worker.
#
# The real Hyperdrive binding should be configured in Cloudflare to use
# the DIRECT Supabase PostgreSQL connection:
#
# postgresql://<YOUR_CREATED_USER>:<YOUR_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#
# Example created user:
# md_pdf_preview


# LOCAL DEVELOPMENT:
# The direct Supabase endpoint is IPv6-only by default.
# On IPv4-only local networks, use the Supabase Session Pooler instead.
#
# IMPORTANT:
# Supavisor requires the project ref as part of the username:
# <YOUR_CREATED_USER>.<PROJECT_REF>
#
# `uselibpqcompat=true&sslmode=require` keeps SSL enabled while avoiding
# certificate verification issues encountered by node-postgres locally.

CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://<YOUR_CREATED_USER>.<PROJECT_REF>:<YOUR_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?uselibpqcompat=true&sslmode=require

DB_SCHEMA=your_schema

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-secure-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Go backend (server-only)
BACKEND_URL=http://localhost:8080
INTERNAL_API_KEY=replace-with-the-same-secret-as-the-go-backend

# Resend (verification and password reset emails, server-only)
RESEND_API_KEY=your-resend-api-key
RESEND_EMAIL_FROM=no-reply@yourdomain.com
RESEND_DAILY_SEND_LIMIT=100
RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
