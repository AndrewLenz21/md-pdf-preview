{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "md-pdf-preview-client",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
  },
  "observability": {
    "enabled": true,
  },
}
